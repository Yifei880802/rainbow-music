# 依赖与构建产物
server/node_modules/
server/dist/
**/*.log

# 运行数据（含下载文件 / SQLite / 音源脚本）
# data/sources/*.js 入库：v0.2.9 镜像内置音源副本（Dockerfile COPY data/sources）需要；
# 目录下其他本地文件（.bak/.disabled 等）仍排除
data/downloads/
data/db/
data/sources/*
!data/sources/*.js
data/*.db
data/*.db-wal
data/*.db-shm

# 真实配置（含密码 / apiKey），改用 config.example.yaml 模板
config.yaml

# 杂项
.DS_Store

# 飞牛 .fpk 打包产物
dist-fpk/

# fnpack 官方打包工具二进制（不入库，获取方式见 docs/DEVELOPMENT.md）
tools/fnpack
