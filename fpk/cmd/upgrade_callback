#!/bin/bash
#
# Rainbow 音乐下载 — 升级钩子：upgrade_callback
#
# 升级文件应用后执行：compose 文件已随新版本替换（含 __WIZ_SCAN_ROOTS__ 占位符与
# 网关挂载），重新拉起容器。数据卷（${TRIM_PKGVAR}）不动，配置（${TRIM_PKGETC}）不重渲染。
# v0.2.1：幂等补渲染音乐库扫描目录挂载与 RO_SCAN_ROOTS —— 老安装（v0.2.0）升级后
# 同样获得网关挂载与新 env；升级无向导值，回读 ${TRIM_PKGETC}/scan-dirs.conf 恢复
# 用户安装时的扫描目录选择，无记录则渲染默认（仅下载目录）。

set -eu

# shellcheck source=/dev/null
source "$(cd "$(dirname "$0")" && pwd)/_common"

ensure_data_dirs
render_scan_mounts
compose_up
exit 0
