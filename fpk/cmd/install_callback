#!/bin/bash
#
# Rainbow 音乐下载 — 安装钩子：install_callback
#
# 安装文件应用后执行：按安装向导（wizard_*）渲染初始 config.yaml + 准备数据目录。
#   - 密码为空 -> 写 $TRIM_TEMP_LOGFILE 后失败退出
#   - 密码/目录经 yaml_dquote_escape + sed RHS 双重转义，双引号标量注入
#   - 幂等：config.yaml 已存在则不覆盖
#   - v0.2.1：渲染音乐库扫描目录挂载与 RO_SCAN_ROOTS（目录不存在仅告警跳过，
#     不阻断安装），并把向导选择持久化到 ${TRIM_PKGETC}/scan-dirs.conf 供升级恢复

set -eu

# shellcheck source=/dev/null
source "$(cd "$(dirname "$0")" && pwd)/_common"

render_config "${wizard_password:-}" "${wizard_port:-}" "${wizard_download_dir:-}"
render_scan_mounts "${wizard_scan_dirs:-}"
ensure_data_dirs
# v0.2.9：网关 socket DB 幂等补写（fnOS 手动安装链不写 gateway 字段的根治项；
# 函数内部全容错恒 return 0，set -e 安全；fnOS 可能稍后才写 app_service 行，
# upgrade_callback 会再跑一次兜底）
fix_gateway_socket
# v0.2.10：全新安装时序缺口兜底——真机实测 fnOS 写入 app_service 行晚于本回调
# 执行（同步 UPDATE 影响 0 行），且随后 trim_sac 周期会把 entry 重同步覆盖回空；
# watcher 后台 30 秒轮询幂等补写两表、双非空即退出（最长 10 分钟），随包自愈。
# 同步调用保留：升级链行早已存在时同步命中，全新安装由 watcher 兜底
fix_gateway_socket_watch
exit 0
