#!/bin/bash
#
# Rainbow 音乐下载 — 安装钩子：install_callback
#
# 安装文件应用后执行：按安装向导（wizard_*）渲染初始 config.yaml + 准备数据目录。
#   - 密码为空 -> 写 $TRIM_TEMP_LOGFILE 后失败退出
#   - 密码/目录经 yaml_dquote_escape + sed RHS 双重转义，双引号标量注入
#   - 幂等：config.yaml 已存在则不覆盖
#   - v0.2.1：渲染音乐库扫描目录挂载与 RO_SCAN_ROOTS（目录不存在仅告警跳过，
#     不阻断安装），并把向导选择持久化到 ${TRIM_PKGETC}/scan-dirs.conf 供升级恢复

set -eu

# shellcheck source=/dev/null
source "$(cd "$(dirname "$0")" && pwd)/_common"

render_config "${wizard_password:-}" "${wizard_port:-}" "${wizard_download_dir:-}"
render_scan_mounts "${wizard_scan_dirs:-}"
ensure_data_dirs
# v0.2.12：安装时刻 marker，供运行时网关注册诊断区分「刚安装等 sacentry
# 同步周期（≤30 分钟）」宽限期（waiting 态）。
# v0.2.13 路径修正（t111 实证 bug#1）：fnOS 仅挂载 data 的三个子目录
# （downloads/sources/db）到容器，data 根目录不挂载 → marker 必须落在已挂载
# 子目录 data/db/（容器内 /app/data/db/install.marker 可见；ensure_data_dirs
# 已建该目录）。首行为 epoch 秒（服务端解析），次行人类可读时间戳。
# 写入时机说明（t111 实证修正）：fnOS 手动升级链会同时跑 install_callback
# 与 upgrade_callback（完整重装语义：app_service 行删除重建、entry 清空）
# ——故升级也会写 marker，这是正确行为（网关重装后确实需重新等注册，
# waiting 态在升级后同样应出现）。写失败仅告警不阻断安装。
printf '%s\n' "$(date +%s)" "$(date -Iseconds)" > "${TRIM_PKGVAR}/data/db/install.marker" 2>/dev/null \
    || log_info "install marker 写入失败（不影响安装，仅诊断 waiting 态降级）"
# v0.2.9：网关 socket DB 幂等补写（fnOS 手动安装链不写 gateway 字段的根治项；
# 函数内部全容错恒 return 0，set -e 安全；fnOS 可能稍后才写 app_service 行，
# upgrade_callback 会再跑一次兜底）。
# v0.2.10：全新安装时序缺口兜底——真机实测 fnOS 写入 app_service 行晚于本回调
# 执行（同步 UPDATE 影响 0 行），且随后 trim_sac 周期会把 entry 重同步覆盖回空，
# 由下方 watcher 后台 30 秒轮询幂等补写两表、双非空即退出（最长 10 分钟）。
# v0.2.11：SQL 执行 docker 化——回调以应用专用用户（uid 975）执行，宿主直跑
# psql 被 pg peer 认证拒绝（v0.2.10 实测静默失败），改经容器内 uid 0 执行；
# watcher 逐轮写 ${TRIM_APPDEST}/gateway-watch.log 消除静默失败
fix_gateway_socket
fix_gateway_socket_watch
exit 0
