#!/bin/bash
#
# Rainbow 音乐下载 — 生命周期脚本公共函数库
#
# 供 cmd/ 下各生命周期脚本 source（fnpack 要求 9 个独立脚本，
# 公共逻辑集中于此，避免重复）。各脚本均以 set -eu 启动。
#
# 约定：
#   - 所有路径只用 TRIM_* 环境变量，不硬编码
#   - 幂等：重复执行各钩子不报错、不破坏已有数据
#   - 失败信息写入 $TRIM_TEMP_LOGFILE 后 exit 1（会展示给用户）

APP_NAME="com.rainbow.music"
COMPOSE_PROJECT="rainbow-music"
COMPOSE_FILE="${TRIM_APPDEST:-}/docker/docker-compose.yaml"
CONFIG_FILE="${TRIM_PKGETC:-}/config.yaml"
# v0.2.6：端口固定 23330（manifest service_port=0 + compose 字面量映射，向导已移除端口项），
# DEFAULT_PORT 兼任渲染兜底与 read_port/probe_status 回落值
DEFAULT_PORT="23330"

# ---------- 通用工具 ----------

log_error() {
    # 用户可见错误：写 TRIM_TEMP_LOGFILE 后退出
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
    fi
    printf '[%s] ERROR: %s\n' "$APP_NAME" "$1" >&2
    exit 1
}

log_info() {
    printf '[%s] %s\n' "$APP_NAME" "$1" >&2
}

dc() {
    # 兼容 docker compose（v2 插件）与 docker-compose（v1 独立）
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose "$@"
    else
        log_error "未找到 docker compose（docker compose / docker-compose 均不可用），请先安装 Docker"
    fi
}

compose_file_ok() {
    [ -n "$COMPOSE_FILE" ] && [ -f "$COMPOSE_FILE" ]
}

read_port() {
    # 从 config.yaml 读 server.port，读不到退回默认值
    local p=""
    if [ -f "$CONFIG_FILE" ]; then
        p=$(awk '/^server:/{f=1;next} f && /^  port:/{print $2; exit} /^[^ ]/{f=0}' "$CONFIG_FILE" | tr -d '"' | tr -d "'" | tr -d ' ')
    fi
    case "$p" in
        ''|*[!0-9]*) echo "$DEFAULT_PORT" ;;
        *) echo "$p" ;;
    esac
}

probe_status() {
    # 0=存活（任何 <500 的 HTTP 响应，含 401） 3=未运行
    local port http_code
    port=$(read_port)
    if ! command -v curl >/dev/null 2>&1; then
        # 没有 curl 就退而检查容器状态
        if docker inspect -f '{{.State.Running}}' rainbow 2>/dev/null | grep -q true; then
            return 0
        fi
        return 3
    fi
    http_code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:${port}/api/v1/status" 2>/dev/null || true)
    [ -n "$http_code" ] || http_code=000
    case "$http_code" in
        000|0*|5*) return 3 ;;
        *) return 0 ;;
    esac
}

# ---------- 配置渲染 ----------

default_download_dir() {
    # v0.2.9：默认容器内相对路径 data/downloads（服务端相对 ROOT_DIR=/app 解析，
    # 即 compose 唯一挂载的 /app/data/downloads ← ${TRIM_PKGVAR}/data/downloads，
    # 容器内自洽、容器重建不丢）。旧版把 TRIM_DATA_SHARE_PATHS（data-share 宿主
    # 绝对路径）或 ${TRIM_PKGVAR}/downloads 写进 config.yaml 的 download.dir，
    # 但 compose 从不挂载这两个目录——下载会落进容器可写层、容器重建即丢
    # （结构性断裂，见 docs/FNOS-DEPLOY.md 2026-08-28 音源章根因二），已弃用。
    # 向导仍可传 wizard_download_dir 绝对路径显式覆盖（语义与限制见部署文档）。
    printf '%s' "data/downloads"
}

sed_escape_rhs() {
    # 转义 sed 替换右侧的 \ & 与分隔符 |
    printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

yaml_dquote_escape() {
    # YAML 双引号标量转义：先转 \ 再转 "（顺序不可颠倒）。
    # 用于密码/下载目录等用户可控字符串：无引号 plain scalar 遇 ` #` 会被截断、
    # 以 &/*/@ 开头或含 `: ` 会解析失败，统一用双引号包裹后安全注入
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

render_config() {
    # $1=密码(必填) $2=端口 $3=下载目录；幂等：已存在则跳过
    local pass="$1" port="$2" ddir="$3"
    if [ -z "$pass" ]; then
        log_error "登录密码不能为空，请在向导中填写密码"
    fi
    [ -n "$port" ] || port="$DEFAULT_PORT"
    [ -n "$ddir" ] || ddir=$(default_download_dir)
    mkdir -p "${TRIM_PKGETC:?}"
    if [ -f "$CONFIG_FILE" ]; then
        log_info "已存在 ${CONFIG_FILE}，跳过初始化渲染"
        return 0
    fi
    local pass_esc ddir_esc
    # 双引号标量注入：先 YAML 转义（\ 与 "），再 sed RHS 转义
    pass_esc=$(sed_escape_rhs "$(yaml_dquote_escape "$pass")")
    ddir_esc=$(sed_escape_rhs "$(yaml_dquote_escape "$ddir")")
    cat > "$CONFIG_FILE" <<'YAML'
server:
  host: 0.0.0.0
  port: __RO_PORT__
auth:
  enabled: true
  apiKey: ""
  webLogin:
    username: admin
    password: "__RO_PASS__"
download:
  dir: "__RO_DOWNLOAD_DIR__"
  concurrency: 3
  defaultQuality: flac
  nameTemplate: "{name} - {singer}"
  embedCover: true
  embedLyric: true
  coverSize: 500
sources:
  dir: data/sources
  hotReload: true
rateLimit:
  enabled: true
  windowMs: 60000
  max: 300
smokeTest:
  enabled: true
  cron: 0 6 * * *
  keyword: 周杰伦
  checkLyric: true
  checkPic: true
  alertThreshold: 2
  alert:
    bark:
      enabled: false
      serverUrl: https://api.day.app
      deviceKey: ""
    serverChan:
      enabled: false
      sendKey: ""
log:
  level: info
YAML
    sed -i.bak \
        -e "s|__RO_PORT__|${port}|" \
        -e "s|__RO_PASS__|${pass_esc}|" \
        -e "s|__RO_DOWNLOAD_DIR__|${ddir_esc}|" \
        "$CONFIG_FILE"
    rm -f "$CONFIG_FILE.bak"
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
    log_info "已生成初始配置 ${CONFIG_FILE}（端口=${port} 下载目录=${ddir}）"
}

# ---------- 音乐库扫描目录渲染（v0.2.1：统一网关 + 本地音乐库） ----------

# 向导扫描目录选择的持久化记录：落在 ${TRIM_PKGETC}（飞牛托管 etc，升级不丢），
# 供 upgrade_callback 在无向导值时恢复用户选择（老安装升级后同样获得新挂载）
SCAN_DIRS_FILE="${TRIM_PKGETC:-}/scan-dirs.conf"

parse_scan_dirs() {
    # 向导输入（英文/全角逗号分隔的 NAS 绝对路径）规范化：
    # 逐行输出，去首尾空白、去空行、去重（保持首次出现顺序）
    printf '%s' "${1:-}" \
        | sed -e 's/，/,/g' \
        | tr ',' '\n' \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        | awk 'NF && !seen[$0]++'
}

render_scan_mounts() {
    # 渲染 compose 的扫描目录挂载行与 RO_SCAN_ROOTS 环境变量：
    #   - 传非空参：以向导值为准，并把原始输入持久化到 ${SCAN_DIRS_FILE}
    #   - 不传参或空串：回读持久化记录；无记录则渲染默认（仅下载目录）
    # 幂等：先清理历史渲染的挂载行，再按锚点重建，同值重复渲染输出完全一致；
    #       RO_SCAN_ROOTS 按行前缀整行替换，兼容占位符与已渲染两种状态
    # 容错：目录不存在仅 log_info 警告并跳过，绝不 exit 1（防应用起不来）
    # v0.2.2：fnOS 升级流程会移除 compose 中 __XXX__ 命名空间内容（旧版 __WIZ_SCAN_ROOTS__
    #       env 行与 __WIZ_SCAN_VOLUMES__ 注释锚点均被剥离）；v0.2.2 起模板默认值直写、
    #       锚点改为 rainbow-scan-volumes-anchor；锚点不存在时仅跳过挂载插入（不报错），
    #       RO_SCAN_ROOTS 行不存在时 sed 无匹配同样静默（服务端 env 缺失时兜底为默认下载目录）
    # v0.2.4：fnOS 升级流程会带空 wizard 参数重跑 install_callback（真机实测：升级后
    #       scan-dirs.conf 被空参调用清空，mtim 与升级时刻一致）——空参不再覆盖持久化，
    #       只有向导有非空值才写入；全新安装空值与升级重跑空参都回落回读/默认，行为安全
    compose_file_ok || return 0
    local raw="" dir i=0
    local roots="/app/data/downloads"
    if [ "$#" -ge 1 ] && [ -n "$1" ]; then
        raw="$1"
        if [ -n "${TRIM_PKGETC:-}" ]; then
            printf '%s\n' "$raw" > "$SCAN_DIRS_FILE" 2>/dev/null || true
        fi
    elif [ -f "$SCAN_DIRS_FILE" ]; then
        raw=$(sed -n '1p' "$SCAN_DIRS_FILE" 2>/dev/null || true)
    fi
    local vol_tmp="${COMPOSE_FILE}.scanvols.tmp"
    : > "$vol_tmp"
    while IFS= read -r dir || [ -n "$dir" ]; do
        [ -n "$dir" ] || continue
        if [ -d "$dir" ]; then
            i=$((i+1))
            printf '      - %s:/app/data/scan/%s\n' "$dir" "$i" >> "$vol_tmp"
            roots="${roots}:/app/data/scan/${i}"
        else
            log_info "音乐库扫描目录不存在，跳过：${dir}"
        fi
    done < <(parse_scan_dirs "$raw")
    # 幂等重建：先删历史挂载行（仅 volumes 段的 - xxx:/app/data/scan/N 形态，
    # 不会误伤 RO_SCAN_ROOTS 值行），再在锚点注释行后插入当前挂载集；
    # 兼容 v0.2.1 旧锚点（fnOS 若未剥离仍可匹配），锚点不存在时跳过插入不报错
    sed -i.bak '/^[[:space:]]*- .*:\/app\/data\/scan\/[0-9][0-9]*$/d' "$COMPOSE_FILE"
    rm -f "${COMPOSE_FILE}.bak"
    if [ -s "$vol_tmp" ]; then
        if grep -q 'rainbow-scan-volumes-anchor' "$COMPOSE_FILE" 2>/dev/null; then
            sed -i.bak "/rainbow-scan-volumes-anchor/r ${vol_tmp}" "$COMPOSE_FILE"
            rm -f "${COMPOSE_FILE}.bak"
        elif grep -q '__WIZ_SCAN_VOLUMES__' "$COMPOSE_FILE" 2>/dev/null; then
            sed -i.bak "/__WIZ_SCAN_VOLUMES__/r ${vol_tmp}" "$COMPOSE_FILE"
            rm -f "${COMPOSE_FILE}.bak"
        else
            log_info "compose 锚点不存在（可能被 fnOS 剥离），跳过扫描目录挂载插入：${vol_tmp} 行"
        fi
    fi
    rm -f "$vol_tmp"
    sed -i.bak "s|^\([[:space:]]*\)RO_SCAN_ROOTS:.*|\1RO_SCAN_ROOTS: \"${roots}\"|" "$COMPOSE_FILE" || true
    rm -f "${COMPOSE_FILE}.bak"
    log_info "音乐库扫描根渲染完成：RO_SCAN_ROOTS=${roots}（额外挂载 ${i} 个目录）"
}

ensure_data_dirs() {
    # 幂等：数据目录落在 ${TRIM_PKGVAR}（飞牛托管，升级/重启不丢）
    local base="${TRIM_PKGVAR:?}"
    mkdir -p "$base/data/downloads" "$base/data/sources" "$base/data/db"
    # 下载目录为宿主绝对路径（旧配置/向导显式覆盖）时确保其存在；
    # v0.2.9：相对路径（默认 data/downloads）由容器内挂载目录提供，
    # 宿主侧无从解析（回调 cwd 未知），不做 mkdir 以免误建目录
    local ddir
    ddir=$(awk '/^download:/{f=1;next} f && /^  dir:/{sub(/^  dir:[ \t]*/,""); print; exit} /^[^ ]/{f=0}' "$CONFIG_FILE" 2>/dev/null | tr -d '"' | tr -d "'")
    case "$ddir" in
        /*) mkdir -p "$ddir" 2>/dev/null || true ;;
    esac
}

# ---------- 网关 socket DB 补写（v0.2.9；v0.2.10 增后台 watcher 兜底时序缺口） ----------

fix_gateway_socket() {
    # fnOS 手动安装（manual_install=t）的 Docker 应用不解析 ui/config 的 gateway 字段
    # （appcenter.app_service 与 trim_sac.entry 的 gateway_socket/gateway_prefix 为空
    # → sacentry 周期无 socket 可注册 → 网关 404；根因见 docs/FNOS-DEPLOY.md
    # 「v0.2.7/v0.2.8 网关 404 第三层根因」章）。
    # 幂等补写：仅当字段为空时 UPDATE（fnOS 已正确写入或本函数先前补写均不动）；
    # 宿主 root 经 pg peer 认证直连。install 时 app_service 行可能尚未由 fnOS 写入
    # （v0.2.10 真机实证：全新安装行 created_at 晚于脚本执行时刻，同步 UPDATE
    # 影响 0 行；升级路径行早已存在则同步命中）——全新安装的时序缺口由紧随其后的
    # fix_gateway_socket_watch 后台 watcher 兜底。本函数在 install_callback /
    # upgrade_callback 成功路径各调用一次（同步调用保留，watcher 随后各自追加）。
    local psql_bin sock prefix app service n
    psql_bin=/usr/lib/postgresql/15/bin/psql
    [ -x "$psql_bin" ] || { log_info "宿主无 psql，跳过网关 socket 补写"; return 0; }
    # 应用名无 TRIM_* 环境变量可用，直接引用本文件顶部定义的 APP_NAME
    app="${APP_NAME}"
    service="${app}.Application"
    sock="/var/apps/${app}/target/app.sock"
    prefix="/app/${app}"
    n=0
    # if 条件上下文：psql 连接失败/库不存在时静默通过（stderr 已丢弃），
    # 绝不阻断安装/升级（函数恒 return 0，set -e 安全）
    if "$psql_bin" -h /run/postgresql -U postgres -d appcenter -Atc \
      "UPDATE app_service SET gateway_socket='${sock}', gateway_prefix='${prefix}', updated_at=now() WHERE service_name='${service}' AND coalesce(gateway_socket,'')='';" 2>/dev/null; then
        n=$((n+1))
    fi
    if "$psql_bin" -h /run/postgresql -U postgres -d trim_sac -Atc \
      "UPDATE entry SET gateway_socket='${sock}', gateway_prefix='${prefix}', updated_at=now() WHERE app_name='${app}' AND service_name='${service}' AND coalesce(gateway_socket,'')='';" 2>/dev/null; then
        n=$((n+1))
    fi
    log_info "网关 socket 补写完成（触发表 ${n}/2；零表示 fnOS 已正确写入或库不可达）"
    return 0
}

render_gateway_watch_script() {
    # 输出一次性 watcher 脚本内容到 stdout（fix_gateway_socket_watch 落盘后 nohup
    # 执行）。生成 side 完成占位符内插：@PSQL@/@APP@/@SVC@/@SOCK@/@PREFIX@ 全部
    # 字面量化，执行 side 是独立 /bin/sh 脚本、不依赖 _common/TRIM_* 环境。
    # 引号嵌套地狱的规避手段：引用 heredoc + sed 占位符替换——运行期变量（$PSQL/
    # $c1/$i/$0 等）原样透传，仅固定参数在生成时内插。
    # 本机验证入口：本函数输出重定向到文件后 sh -n 即可干跑语法检查。
    local psql_bin app service sock prefix
    psql_bin=/usr/lib/postgresql/15/bin/psql
    app="${APP_NAME}"
    service="${app}.Application"
    sock="/var/apps/${app}/target/app.sock"
    prefix="/app/${app}"
    sed -e "s|@PSQL@|${psql_bin}|g" -e "s|@APP@|${app}|g" -e "s|@SVC@|${service}|g" \
        -e "s|@SOCK@|${sock}|g" -e "s|@PREFIX@|${prefix}|g" <<'WATCH'
#!/bin/sh
#
# Rainbow 网关 socket 补写 watcher（一次性；由 fpk/cmd/_common 的
# fix_gateway_socket_watch 生成，参数已全部字面量化，无外部依赖）。
#
# 背景（v0.2.10 时序缺口）：全新安装时 fnOS 写入 appcenter.app_service 行晚于
# install_callback 执行（v0.2.9 真机实测），同步补写 UPDATE 影响 0 行；随后
# trim_sac 周期又会从空 app_service 重同步覆盖 entry 回空 → 网关 404。
#
# 逻辑（30 秒一轮 × 20 轮 = 10 分钟窗口）：
#   - app_service / entry 两表均存在 gateway_socket 非空的行 → 已自愈，干净退出
#   - 否则执行与 fix_gateway_socket 相同的两个幂等 UPDATE（仅空字段才补）
#   - 超时（10 分钟）正常退出；EXIT trap 自删本文件，不留持久痕迹
#
PSQL='@PSQL@'
APP='@APP@'
SVC='@SVC@'
SOCK='@SOCK@'
PREFIX='@PREFIX@'

trap 'rm -f "$0" 2>/dev/null' EXIT
[ -x "$PSQL" ] || exit 0

i=1
while [ "$i" -le 20 ]; do
    sleep 30
    c1=$("$PSQL" -h /run/postgresql -U postgres -d appcenter -Atc \
        "SELECT count(*) FROM app_service WHERE service_name='${SVC}' AND coalesce(gateway_socket,'')<>''" 2>/dev/null) || c1=''
    c2=$("$PSQL" -h /run/postgresql -U postgres -d trim_sac -Atc \
        "SELECT count(*) FROM entry WHERE app_name='${APP}' AND coalesce(gateway_socket,'')<>''" 2>/dev/null) || c2=''
    case "$c1" in ''|*[!0-9]*) c1=0 ;; esac
    case "$c2" in ''|*[!0-9]*) c2=0 ;; esac
    if [ "$c1" -ge 1 ] && [ "$c2" -ge 1 ]; then
        exit 0
    fi
    "$PSQL" -h /run/postgresql -U postgres -d appcenter -Atc \
        "UPDATE app_service SET gateway_socket='${SOCK}', gateway_prefix='${PREFIX}', updated_at=now() WHERE service_name='${SVC}' AND coalesce(gateway_socket,'')='';" 2>/dev/null || true
    "$PSQL" -h /run/postgresql -U postgres -d trim_sac -Atc \
        "UPDATE entry SET gateway_socket='${SOCK}', gateway_prefix='${PREFIX}', updated_at=now() WHERE app_name='${APP}' AND service_name='${SVC}' AND coalesce(gateway_socket,'')='';" 2>/dev/null || true
    i=$((i+1))
done
exit 0
WATCH
}

fix_gateway_socket_watch() {
    # v0.2.10：install 时序缺口的兜底。install_callback 执行时 fnOS 可能尚未写入
    # appcenter.app_service 行（v0.2.9 真机实测：行 created_at 晚于脚本执行时刻，
    # fix_gateway_socket 的同步 UPDATE 影响 0 行），且随后 trim_sac 周期从空
    # app_service 重同步会把 entry 覆盖回空 → 网关 404 需人工热修。本函数生成
    # 一次性 watcher 脚本落 /tmp 后 nohup 后台执行文件路径：
    #   - 脱离安装进程（孤儿进程重挂 init，nohup 忽略 SIGHUP）；三向重定向后
    #     不占用安装流程的 stdin/stdout/stderr，不阻塞回调返回；
    #   - 后台启动 `cmd &` 在 set -eu 下恒返回 0（仅 fork 失败非零），安全；
    #   - watcher 30 秒轮询两表、空则幂等补写、双非空即退出、最长 10 分钟，
    #     脚本 EXIT trap 自删（/tmp 临时文件不留持久痕迹）。
    # 幂等无害：install/upgrade 各启动一次；fnOS 升级链重跑 install_callback
    # 的场景可能并发两个 watcher，UPDATE 仅补空字段，互不冲突。
    local psql_bin tmp
    psql_bin=/usr/lib/postgresql/15/bin/psql
    [ -x "$psql_bin" ] || { log_info "宿主无 psql，跳过网关 socket watcher"; return 0; }
    tmp=$(mktemp /tmp/rainbow-gw-watch.XXXXXX 2>/dev/null) || {
        log_info "网关 socket watcher：临时文件创建失败，跳过"
        return 0
    }
    if ! render_gateway_watch_script > "$tmp" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        log_info "网关 socket watcher：脚本生成失败，跳过"
        return 0
    fi
    nohup sh "$tmp" </dev/null >/dev/null 2>&1 &
    log_info "已启动网关 socket 补写 watcher（后台，最长 10 分钟）"
    return 0
}

compose_up() {
    compose_file_ok || log_error "找不到 compose 文件：$COMPOSE_FILE"
    dc -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" up -d
}

compose_down() {
    compose_file_ok || return 0
    dc -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" down || true
}
