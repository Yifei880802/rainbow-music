#!/bin/bash
#
# Rainbow 音乐下载 — 生命周期脚本公共函数库
#
# 供 cmd/ 下各生命周期脚本 source（fnpack 要求 9 个独立脚本，
# 公共逻辑集中于此，避免重复）。各脚本均以 set -eu 启动。
#
# 约定：
#   - 所有路径只用 TRIM_* 环境变量，不硬编码
#   - 幂等：重复执行各钩子不报错、不破坏已有数据
#   - 失败信息写入 $TRIM_TEMP_LOGFILE 后 exit 1（会展示给用户）

APP_NAME="com.rainbow.music"
COMPOSE_PROJECT="rainbow-music"
COMPOSE_FILE="${TRIM_APPDEST:-}/docker/docker-compose.yaml"
CONFIG_FILE="${TRIM_PKGETC:-}/config.yaml"
# v0.2.6：端口固定 23330（manifest service_port=0 + compose 字面量映射，向导已移除端口项），
# DEFAULT_PORT 兼任渲染兜底与 read_port/probe_status 回落值
DEFAULT_PORT="23330"

# ---------- 通用工具 ----------

log_error() {
    # 用户可见错误：写 TRIM_TEMP_LOGFILE 后退出
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
    fi
    printf '[%s] ERROR: %s\n' "$APP_NAME" "$1" >&2
    exit 1
}

log_info() {
    printf '[%s] %s\n' "$APP_NAME" "$1" >&2
}

dc() {
    # 兼容 docker compose（v2 插件）与 docker-compose（v1 独立）
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose "$@"
    else
        log_error "未找到 docker compose（docker compose / docker-compose 均不可用），请先安装 Docker"
    fi
}

compose_file_ok() {
    [ -n "$COMPOSE_FILE" ] && [ -f "$COMPOSE_FILE" ]
}

read_port() {
    # 从 config.yaml 读 server.port，读不到退回默认值
    local p=""
    if [ -f "$CONFIG_FILE" ]; then
        p=$(awk '/^server:/{f=1;next} f && /^  port:/{print $2; exit} /^[^ ]/{f=0}' "$CONFIG_FILE" | tr -d '"' | tr -d "'" | tr -d ' ')
    fi
    case "$p" in
        ''|*[!0-9]*) echo "$DEFAULT_PORT" ;;
        *) echo "$p" ;;
    esac
}

probe_status() {
    # 0=存活（任何 <500 的 HTTP 响应，含 401） 3=未运行
    local port http_code
    port=$(read_port)
    if ! command -v curl >/dev/null 2>&1; then
        # 没有 curl 就退而检查容器状态
        if docker inspect -f '{{.State.Running}}' rainbow 2>/dev/null | grep -q true; then
            return 0
        fi
        return 3
    fi
    http_code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:${port}/api/v1/status" 2>/dev/null || true)
    [ -n "$http_code" ] || http_code=000
    case "$http_code" in
        000|0*|5*) return 3 ;;
        *) return 0 ;;
    esac
}

# ---------- 配置渲染 ----------

default_download_dir() {
    # v0.2.9：默认容器内相对路径 data/downloads（服务端相对 ROOT_DIR=/app 解析，
    # 即 compose 唯一挂载的 /app/data/downloads ← ${TRIM_PKGVAR}/data/downloads，
    # 容器内自洽、容器重建不丢）。旧版把 TRIM_DATA_SHARE_PATHS（data-share 宿主
    # 绝对路径）或 ${TRIM_PKGVAR}/downloads 写进 config.yaml 的 download.dir，
    # 但 compose 从不挂载这两个目录——下载会落进容器可写层、容器重建即丢
    # （结构性断裂，见 docs/FNOS-DEPLOY.md 2026-08-28 音源章根因二），已弃用。
    # 向导仍可传 wizard_download_dir 绝对路径显式覆盖（语义与限制见部署文档）。
    printf '%s' "data/downloads"
}

sed_escape_rhs() {
    # 转义 sed 替换右侧的 \ & 与分隔符 |
    printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

yaml_dquote_escape() {
    # YAML 双引号标量转义：先转 \ 再转 "（顺序不可颠倒）。
    # 用于密码/下载目录等用户可控字符串：无引号 plain scalar 遇 ` #` 会被截断、
    # 以 &/*/@ 开头或含 `: ` 会解析失败，统一用双引号包裹后安全注入
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

render_config() {
    # $1=密码(必填) $2=端口 $3=下载目录；幂等：已存在则跳过
    local pass="$1" port="$2" ddir="$3"
    if [ -z "$pass" ]; then
        log_error "登录密码不能为空，请在向导中填写密码"
    fi
    [ -n "$port" ] || port="$DEFAULT_PORT"
    [ -n "$ddir" ] || ddir=$(default_download_dir)
    mkdir -p "${TRIM_PKGETC:?}"
    if [ -f "$CONFIG_FILE" ]; then
        log_info "已存在 ${CONFIG_FILE}，跳过初始化渲染"
        return 0
    fi
    local pass_esc ddir_esc
    # 双引号标量注入：先 YAML 转义（\ 与 "），再 sed RHS 转义
    pass_esc=$(sed_escape_rhs "$(yaml_dquote_escape "$pass")")
    ddir_esc=$(sed_escape_rhs "$(yaml_dquote_escape "$ddir")")
    cat > "$CONFIG_FILE" <<'YAML'
server:
  host: 0.0.0.0
  port: __RO_PORT__
auth:
  enabled: true
  apiKey: ""
  webLogin:
    username: admin
    password: "__RO_PASS__"
download:
  dir: "__RO_DOWNLOAD_DIR__"
  concurrency: 3
  defaultQuality: flac
  nameTemplate: "{name} - {singer}"
  embedCover: true
  embedLyric: true
  coverSize: 500
sources:
  dir: data/sources
  hotReload: true
rateLimit:
  enabled: true
  windowMs: 60000
  max: 300
smokeTest:
  enabled: true
  cron: 0 6 * * *
  keyword: 周杰伦
  checkLyric: true
  checkPic: true
  alertThreshold: 2
  alert:
    bark:
      enabled: false
      serverUrl: https://api.day.app
      deviceKey: ""
    serverChan:
      enabled: false
      sendKey: ""
log:
  level: info
YAML
    sed -i.bak \
        -e "s|__RO_PORT__|${port}|" \
        -e "s|__RO_PASS__|${pass_esc}|" \
        -e "s|__RO_DOWNLOAD_DIR__|${ddir_esc}|" \
        "$CONFIG_FILE"
    rm -f "$CONFIG_FILE.bak"
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
    log_info "已生成初始配置 ${CONFIG_FILE}（端口=${port} 下载目录=${ddir}）"
}

# ---------- 音乐库扫描目录渲染（v0.2.1：统一网关 + 本地音乐库） ----------

# 向导扫描目录选择的持久化记录：落在 ${TRIM_PKGETC}（飞牛托管 etc，升级不丢），
# 供 upgrade_callback 在无向导值时恢复用户选择（老安装升级后同样获得新挂载）
SCAN_DIRS_FILE="${TRIM_PKGETC:-}/scan-dirs.conf"

parse_scan_dirs() {
    # 向导输入（英文/全角逗号分隔的 NAS 绝对路径）规范化：
    # 逐行输出，去首尾空白、去空行、去重（保持首次出现顺序）
    printf '%s' "${1:-}" \
        | sed -e 's/，/,/g' \
        | tr ',' '\n' \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        | awk 'NF && !seen[$0]++'
}

render_scan_mounts() {
    # 渲染 compose 的扫描目录挂载行与 RO_SCAN_ROOTS 环境变量：
    #   - 传非空参：以向导值为准，并把原始输入持久化到 ${SCAN_DIRS_FILE}
    #   - 不传参或空串：回读持久化记录；无记录则渲染默认（仅下载目录）
    # 幂等：先清理历史渲染的挂载行，再按锚点重建，同值重复渲染输出完全一致；
    #       RO_SCAN_ROOTS 按行前缀整行替换，兼容占位符与已渲染两种状态
    # 容错：目录不存在仅 log_info 警告并跳过，绝不 exit 1（防应用起不来）
    # v0.2.2：fnOS 升级流程会移除 compose 中 __XXX__ 命名空间内容（旧版 __WIZ_SCAN_ROOTS__
    #       env 行与 __WIZ_SCAN_VOLUMES__ 注释锚点均被剥离）；v0.2.2 起模板默认值直写、
    #       锚点改为 rainbow-scan-volumes-anchor；锚点不存在时仅跳过挂载插入（不报错），
    #       RO_SCAN_ROOTS 行不存在时 sed 无匹配同样静默（服务端 env 缺失时兜底为默认下载目录）
    # v0.2.4：fnOS 升级流程会带空 wizard 参数重跑 install_callback（真机实测：升级后
    #       scan-dirs.conf 被空参调用清空，mtim 与升级时刻一致）——空参不再覆盖持久化，
    #       只有向导有非空值才写入；全新安装空值与升级重跑空参都回落回读/默认，行为安全
    compose_file_ok || return 0
    local raw="" dir i=0
    local roots="/app/data/downloads"
    if [ "$#" -ge 1 ] && [ -n "$1" ]; then
        raw="$1"
        if [ -n "${TRIM_PKGETC:-}" ]; then
            printf '%s\n' "$raw" > "$SCAN_DIRS_FILE" 2>/dev/null || true
        fi
    elif [ -f "$SCAN_DIRS_FILE" ]; then
        raw=$(sed -n '1p' "$SCAN_DIRS_FILE" 2>/dev/null || true)
    fi
    local vol_tmp="${COMPOSE_FILE}.scanvols.tmp"
    : > "$vol_tmp"
    while IFS= read -r dir || [ -n "$dir" ]; do
        [ -n "$dir" ] || continue
        if [ -d "$dir" ]; then
            i=$((i+1))
            printf '      - %s:/app/data/scan/%s\n' "$dir" "$i" >> "$vol_tmp"
            roots="${roots}:/app/data/scan/${i}"
        else
            log_info "音乐库扫描目录不存在，跳过：${dir}"
        fi
    done < <(parse_scan_dirs "$raw")
    # 幂等重建：先删历史挂载行（仅 volumes 段的 - xxx:/app/data/scan/N 形态，
    # 不会误伤 RO_SCAN_ROOTS 值行），再在锚点注释行后插入当前挂载集；
    # 兼容 v0.2.1 旧锚点（fnOS 若未剥离仍可匹配），锚点不存在时跳过插入不报错
    sed -i.bak '/^[[:space:]]*- .*:\/app\/data\/scan\/[0-9][0-9]*$/d' "$COMPOSE_FILE"
    rm -f "${COMPOSE_FILE}.bak"
    if [ -s "$vol_tmp" ]; then
        if grep -q 'rainbow-scan-volumes-anchor' "$COMPOSE_FILE" 2>/dev/null; then
            sed -i.bak "/rainbow-scan-volumes-anchor/r ${vol_tmp}" "$COMPOSE_FILE"
            rm -f "${COMPOSE_FILE}.bak"
        elif grep -q '__WIZ_SCAN_VOLUMES__' "$COMPOSE_FILE" 2>/dev/null; then
            sed -i.bak "/__WIZ_SCAN_VOLUMES__/r ${vol_tmp}" "$COMPOSE_FILE"
            rm -f "${COMPOSE_FILE}.bak"
        else
            log_info "compose 锚点不存在（可能被 fnOS 剥离），跳过扫描目录挂载插入：${vol_tmp} 行"
        fi
    fi
    rm -f "$vol_tmp"
    sed -i.bak "s|^\([[:space:]]*\)RO_SCAN_ROOTS:.*|\1RO_SCAN_ROOTS: \"${roots}\"|" "$COMPOSE_FILE" || true
    rm -f "${COMPOSE_FILE}.bak"
    log_info "音乐库扫描根渲染完成：RO_SCAN_ROOTS=${roots}（额外挂载 ${i} 个目录）"
}

ensure_data_dirs() {
    # 幂等：数据目录落在 ${TRIM_PKGVAR}（飞牛托管，升级/重启不丢）
    local base="${TRIM_PKGVAR:?}"
    mkdir -p "$base/data/downloads" "$base/data/sources" "$base/data/db"
    # 下载目录为宿主绝对路径（旧配置/向导显式覆盖）时确保其存在；
    # v0.2.9：相对路径（默认 data/downloads）由容器内挂载目录提供，
    # 宿主侧无从解析（回调 cwd 未知），不做 mkdir 以免误建目录
    local ddir
    ddir=$(awk '/^download:/{f=1;next} f && /^  dir:/{sub(/^  dir:[ \t]*/,""); print; exit} /^[^ ]/{f=0}' "$CONFIG_FILE" 2>/dev/null | tr -d '"' | tr -d "'")
    case "$ddir" in
        /*) mkdir -p "$ddir" 2>/dev/null || true ;;
    esac
}

# ---------- 网关 socket DB 补写（v0.2.9 引入；v0.2.10 watcher；v0.2.11 docker 化执行） ----------

# rb_psql 的失败原因（供调用方 log_info；空表示无失败或未调用）
rb_psql_err=""

rb_psql() {
    # $1=库名 $2=SQL；stdout=psql 输出（-Atc），失败输出空、原因写入全局 rb_psql_err。
    # v0.2.11：回调执行身份是应用专用系统用户（uid 975，非 root），宿主直跑 psql
    # 被 pg peer 认证拒绝（pg_hba local peer + pg_ident trim_root 仅映射 root）
    # ——v0.2.10 真机实证 watcher 20 轮 UPDATE 全部被静默吞掉。改经 docker 容器
    # （默认 uid 0）执行宿主 psql：容器进程经共享 unix socket 的 peer 凭据为
    # root，trim_root 放行（真机探针 20 余次 100% 成功的配方）。
    # 依赖：docker CLI（回调可用，与 compose_up 同通道）、宿主 loader/psql、
    # compose 落盘文件的 image: 行（用 rainbow 自身镜像，与宿主 lib 兼容已实证）。
    local db="$1" sql="$2" img errf
    local loader=/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2
    local psqlbin=/usr/lib/postgresql/15/bin/psql
    rb_psql_err=""
    command -v docker >/dev/null 2>&1 || { rb_psql_err="docker CLI 不可用"; return 1; }
    [ -x "$loader" ] || { rb_psql_err="宿主 loader 缺失（${loader}，非 x86_64 或路径变化）"; return 1; }
    [ -x "$psqlbin" ] || { rb_psql_err="宿主 psql 缺失（${psqlbin}）"; return 1; }
    img=$(sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "$COMPOSE_FILE" 2>/dev/null | head -1 | tr -d "\"'")
    [ -n "$img" ] || { rb_psql_err="compose 未取到 image（${COMPOSE_FILE:-未设置}）"; return 1; }
    # stderr 落临时文件：失败时压缩全文入 rb_psql_err（可观测），用完即删。
    # v0.2.14（t114 纠偏）：撤销 v0.2.13 加的镜像名后 -- 分隔符——t114 三重复现
    # 证伪（uid 0 对照：旧语法本就 rc=0 正常输出；带 -- 反被 docker 透传给
    # loader 致 usage 错）；真因始终是回调 uid 975 连 docker.sock EACCES
    # （t107/t114 实证），与语法无关。同时 stderr 从「tail -1 末行」改为
    # 压缩全文（换行→" | "）：docker 多行错误的末行是 usage 提示，真实错误
    # （EACCES）在第 2 行——末行截取曾致 t111/t114 两轮误诊（tail -1 陷阱）。
    errf="/tmp/rb-psql-err.$$"
    if docker run --rm \
        -v /usr:/husr:ro -v /run:/hrun:ro \
        --entrypoint "$loader" "$img" \
        --library-path /husr/lib/x86_64-linux-gnu:/husr/lib:/husr/lib/postgresql/15/lib \
        "$psqlbin" -h /hrun/postgresql -U postgres -d "$db" -Atc "$sql" 2>"$errf"; then
        rm -f "$errf" 2>/dev/null
        return 0
    fi
    # 压缩全文（awk，POSIX 可移植）：多行 stderr → 单行 " | " 分隔
    rb_psql_err=$(awk 'NR>1 {printf " | "} {printf "%s", $0}' "$errf" 2>/dev/null)
    rm -f "$errf" 2>/dev/null
    [ -n "$rb_psql_err" ] || rb_psql_err="docker run 失败（stderr 空）"
    return 1
}

fix_gateway_socket() {
    # fnOS 手动安装（manual_install=t）的 Docker 应用不解析 ui/config 的 gateway 字段
    # （appcenter.app_service 与 trim_sac.entry 的 gateway_socket/gateway_prefix 为空
    # → sacentry 周期无 socket 可注册 → 网关 404；根因见 docs/FNOS-DEPLOY.md
    # 「v0.2.7/v0.2.8 网关 404 第三层根因」章）。
    # 幂等补写：仅当字段为空时 UPDATE（fnOS 已正确写入或本函数先前补写均不动）。
    # v0.2.11：SQL 执行改走 rb_psql（docker 容器内跑宿主 psql）——v0.2.10 真机实测
    # 发现回调以应用专用用户（uid 975）执行，宿主直跑 psql 被 pg peer 认证拒绝
    # （pg_ident trim_root 仅映射 root），v0.2.9~v0.2.10 的直连 UPDATE 从未真正生效
    # （升级路径「同步命中」实为旧值残留假象）。install 时 app_service 行可能尚未
    # 由 fnOS 写入（时序缺口，同步 UPDATE 影响 0 行）——由紧随其后的
    # fix_gateway_socket_watch 后台 watcher 兜底。本函数在 install_callback /
    # upgrade_callback 成功路径各调用一次（同步调用保留，watcher 随后各自追加）。
    local app service sock prefix out n a b
    app="${APP_NAME}"
    service="${app}.Application"
    sock="/var/apps/${app}/target/app.sock"
    prefix="/app/${app}"
    n=0 a=0 b=0
    # 失败分支（docker/loader/psql/image 缺失或 docker run 失败）log_info 提示后继续，
    # 绝不阻断安装/升级（函数恒 return 0，set -e 安全）
    out=$(rb_psql appcenter "UPDATE app_service SET gateway_socket='${sock}', gateway_prefix='${prefix}', updated_at=now() WHERE service_name='${service}' AND coalesce(gateway_socket,'')='';") \
        || log_info "网关补写 appcenter 未执行：${rb_psql_err:-未知}"
    case "$out" in UPDATE\ *) n=$((n+1)); a=${out#UPDATE } ;; esac
    out=$(rb_psql trim_sac "UPDATE entry SET gateway_socket='${sock}', gateway_prefix='${prefix}', updated_at=now() WHERE app_name='${app}' AND service_name='${service}' AND coalesce(gateway_socket,'')='';") \
        || log_info "网关补写 trim_sac 未执行：${rb_psql_err:-未知}"
    case "$out" in UPDATE\ *) n=$((n+1)); b=${out#UPDATE } ;; esac
    log_info "网关 socket 补写完成（触发表 ${n}/2，补写行数 appcenter=${a} entry=${b}；零表示 fnOS 已正确写入或调用失败，后续轮次见 gateway-watch.log）"
    return 0
}

render_gateway_watch_script() {
    # 输出一次性 watcher 脚本内容到 stdout（fix_gateway_socket_watch 落盘后 nohup
    # 执行）。生成 side 完成占位符内插：@IMG@/@LOADER@/@PSQL@/@LOG@/@APP@/@SVC@/
    # @SOCK@/@PREFIX@ 全部字面量化，执行 side 是独立 /bin/sh 脚本、不依赖
    # _common/TRIM_* 环境。引用 heredoc + sed 占位符替换规避引号嵌套地狱：
    # 运行期变量（$QOUT/$WERR/$i/$0 等）原样透传，仅固定参数在生成时内插。
    # v0.2.11：SQL 执行与 rb_psql 同款 docker run 调用（镜像名从 compose 取后内插）；
    # 每轮往 @LOG@（TRIM_APPDEST/gateway-watch.log）追加观测行，失败不再静默。
    # 本机验证入口：本函数输出重定向到文件后 sh -n 即可干跑语法检查。
    local app service sock prefix img logf appdest
    app="${APP_NAME}"
    service="${app}.Application"
    sock="/var/apps/${app}/target/app.sock"
    prefix="/app/${app}"
    appdest="${TRIM_APPDEST:-/vol2/@appcenter/${app}}"
    logf="${appdest}/gateway-watch.log"
    img=$(sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "$COMPOSE_FILE" 2>/dev/null | head -1 | tr -d "\"'")
    [ -n "$img" ] || img="UNRESOLVED"
    sed -e "s|@IMG@|$(sed_escape_rhs "$img")|g" \
        -e "s|@LOADER@|/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2|g" \
        -e "s|@PSQL@|/usr/lib/postgresql/15/bin/psql|g" \
        -e "s|@LOG@|$(sed_escape_rhs "$logf")|g" \
        -e "s|@APP@|$(sed_escape_rhs "$app")|g" \
        -e "s|@SVC@|$(sed_escape_rhs "$service")|g" \
        -e "s|@SOCK@|$(sed_escape_rhs "$sock")|g" \
        -e "s|@PREFIX@|$(sed_escape_rhs "$prefix")|g" <<'WATCH'
#!/bin/sh
#
# Rainbow 网关 socket 补写 watcher v2（一次性；由 fpk/cmd/_common 的
# fix_gateway_socket_watch 生成，参数已全部字面量化，无外部依赖）。
#
# 背景（v0.2.10 真机实测深层根因）：fnOS 回调以应用专用用户（uid 975）执行，
# 宿主直跑 psql 被 pg peer 认证拒绝（pg_ident trim_root 仅映射 root）——
# v0.2.10 的 20 轮 UPDATE 曾全部被静默吞掉。SQL 改经 docker 容器执行
# （容器 uid 0，共享 unix socket 的 peer 凭据为 root，trim_root 放行；
# 真机探针 20 余次 100% 成功的配方）。
#
# 逻辑（30 秒一轮 × 20 轮 = 10 分钟窗口）：
#   - 每轮查两表 gateway_socket 非空行数（c1/c2），逐轮写一行到 @LOG@
#   - 双非空 → 已自愈，写退出行后干净退出
#   - 否则两个幂等 UPDATE（仅空字段才补），updated=A/B 记录影响行数
#   - docker/psql 失败不静默：stderr 压缩全文写入日志（psql-err=...，v0.2.14：
#     多行换行→" | "单行——末行截取曾致误诊，见 q 函数注），本轮跳过继续
#   - 超时（10 分钟）写超时行后正常退出；EXIT trap 自删本文件
#
IMG='@IMG@'
LOADER='@LOADER@'
PSQLBIN='@PSQL@'
LOG='@LOG@'
APP='@APP@'
SVC='@SVC@'
SOCK='@SOCK@'
PREFIX='@PREFIX@'

wlog() {
    printf '%s %s\n' "$(date '+%F %T')" "$1" >> "$LOG" 2>/dev/null || true
}

# SQL 执行：$1=库 $2=SQL；成功 rc=0、QOUT=psql stdout 末行；失败 rc≠0、WERR=stderr 压缩全文
# （不用命令替换调 q：子 shell 内的全局变量赋值回不到本层）
# v0.2.14（t114 纠偏）：撤销 v0.2.13 的镜像名后 -- 分隔符——t114 三重复现证伪
# （uid 0 下旧语法本就 rc=0；-- 被 docker 透传给 ld-linux 致 usage 错；真因是
# 回调 uid 975 连 docker.sock EACCES）；WERR 从「tail -1 末行」改为压缩全文
# （换行→" | "）：docker 多行错误末行是 usage 提示（Run 'docker run --help'），
# 真实错误（EACCES）在第 2 行——末行截取曾致 t111 误诊（tail -1 陷阱）
QOUT=''
WERR=''
q() {
    QOUT=''
    WERR=''
    qerrf="/tmp/rainbow-gw-qerr.$$"
    QOUT=$(docker run --rm \
        -v /usr:/husr:ro -v /run:/hrun:ro \
        --entrypoint "$LOADER" "$IMG" \
        --library-path /husr/lib/x86_64-linux-gnu:/husr/lib:/husr/lib/postgresql/15/lib \
        "$PSQLBIN" -h /hrun/postgresql -U postgres -d "$1" -Atc "$2" 2>"$qerrf") || {
        # 压缩全文（awk，POSIX sh 可移植）：多行 stderr → 单行 " | " 分隔
        WERR=$(awk 'NR>1 {printf " | "} {printf "%s", $0}' "$qerrf" 2>/dev/null)
        rm -f "$qerrf"
        return 1
    }
    rm -f "$qerrf"
    QOUT=$(printf '%s\n' "$QOUT" | tail -n 1)
    return 0
}

trap 'rm -f "$0" 2>/dev/null' EXIT

wlog "watcher start pid=$$ img=${IMG} rounds=20 interval=30s"

if ! command -v docker >/dev/null 2>&1; then
    wlog "watcher exit reason=no-docker-cli"
    exit 0
fi
if [ ! -x "$LOADER" ] || [ ! -x "$PSQLBIN" ]; then
    wlog "watcher exit reason=loader-or-psql-missing loader=${LOADER}"
    exit 0
fi

i=1
while [ "$i" -le 20 ]; do
    sleep 30
    c1='?'
    c2='?'
    a='?'
    b='?'
    perr=''
    if q appcenter "SELECT count(*) FROM app_service WHERE service_name='${SVC}' AND coalesce(gateway_socket,'')<>''"; then
        c1="$QOUT"
        case "$c1" in ''|*[!0-9]*) c1=0 ;; esac
    else
        perr="${WERR:-docker run 失败}"
    fi
    if q trim_sac "SELECT count(*) FROM entry WHERE app_name='${APP}' AND coalesce(gateway_socket,'')<>''"; then
        c2="$QOUT"
        case "$c2" in ''|*[!0-9]*) c2=0 ;; esac
    else
        [ -n "$perr" ] || perr="${WERR:-docker run 失败}"
    fi
    if [ "$c1" != '?' ] && [ "$c2" != '?' ] && [ "$c1" -ge 1 ] && [ "$c2" -ge 1 ]; then
        wlog "round=$i c1=$c1 c2=$c2 self-healed"
        wlog "watcher exit reason=self-healed rounds=$i"
        exit 0
    fi
    if q appcenter "UPDATE app_service SET gateway_socket='${SOCK}', gateway_prefix='${PREFIX}', updated_at=now() WHERE service_name='${SVC}' AND coalesce(gateway_socket,'')='';"; then
        a="$QOUT"
        case "$a" in UPDATE\ *) a=${a#UPDATE } ;; *) a='?' ;; esac
    else
        a='err'
        [ -n "$perr" ] || perr="u:${WERR:-docker run 失败}"
    fi
    if q trim_sac "UPDATE entry SET gateway_socket='${SOCK}', gateway_prefix='${PREFIX}', updated_at=now() WHERE app_name='${APP}' AND service_name='${SVC}' AND coalesce(gateway_socket,'')='';"; then
        b="$QOUT"
        case "$b" in UPDATE\ *) b=${b#UPDATE } ;; *) b='?' ;; esac
    else
        b='err'
        [ -n "$perr" ] || perr="u:${WERR:-docker run 失败}"
    fi
    wlog "round=$i c1=$c1 c2=$c2 updated=$a/$b${perr:+ psql-err=$perr}"
    i=$((i+1))
done
wlog "watcher exit reason=timeout rounds=$((i-1))"
exit 0
WATCH
}

fix_gateway_socket_watch() {
    # v0.2.10：install 时序缺口的兜底（fnOS 写 app_service 行晚于回调执行，同步
    # UPDATE 落空；trim_sac 周期还会从空 app_service 重同步覆盖 entry 回空）。
    # v0.2.11：SQL 执行 docker 化（回调 uid 975 过不了 pg peer 认证，直连 psql
    # 从未生效；容器内 uid 0 可过，真机实证配方）+ 逐轮日志
    # （${TRIM_APPDEST}/gateway-watch.log，含 psql-err 失败行，消除静默失败）。
    # 启动形态：一次性脚本落 /tmp 后 nohup sh <文件> 后台执行——
    #   - 脱离安装进程（孤儿进程重挂 init，nohup 忽略 SIGHUP）；三向重定向后
    #     不占用安装流程的 stdin/stdout/stderr，不阻塞回调返回；
    #   - 后台启动 `cmd &` 在 set -eu 下恒返回 0（仅 fork 失败非零），安全；
    #   - watcher 30 秒轮询两表、空则幂等补写、双非空即退出、最长 10 分钟，
    #     脚本 EXIT trap 自删（/tmp 临时文件不留持久痕迹）。
    # 幂等无害：install/upgrade 各启动一次；fnOS 升级链重跑 install_callback
    # 的场景可能并发两个 watcher，UPDATE 仅补空字段，互不冲突。
    local img loader psqlbin tmp appdest
    loader=/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2
    psqlbin=/usr/lib/postgresql/15/bin/psql
    appdest="${TRIM_APPDEST:-/vol2/@appcenter/${APP_NAME}}"
    command -v docker >/dev/null 2>&1 || { log_info "宿主无 docker CLI，跳过网关 socket watcher"; return 0; }
    [ -x "$loader" ] && [ -x "$psqlbin" ] || { log_info "宿主缺 loader/psql（x86_64 布局），跳过网关 socket watcher"; return 0; }
    img=$(sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "$COMPOSE_FILE" 2>/dev/null | head -1 | tr -d "\"'")
    [ -n "$img" ] || { log_info "compose 未取到 image（${COMPOSE_FILE:-未设置}），跳过网关 socket watcher"; return 0; }
    tmp=$(mktemp /tmp/rainbow-gw-watch.XXXXXX 2>/dev/null) || {
        log_info "网关 socket watcher：临时文件创建失败，跳过"
        return 0
    }
    if ! render_gateway_watch_script > "$tmp" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        log_info "网关 socket watcher：脚本生成失败，跳过"
        return 0
    fi
    nohup sh "$tmp" </dev/null >/dev/null 2>&1 &
    log_info "已启动网关 socket 补写 watcher（后台，最长 10 分钟；日志 ${appdest}/gateway-watch.log）"
    return 0
}

compose_up() {
    compose_file_ok || log_error "找不到 compose 文件：$COMPOSE_FILE"
    dc -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" up -d
}

compose_down() {
    compose_file_ok || return 0
    dc -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" down || true
}
