#!/bin/bash
#
# Rainbow 音乐下载 — 配置向导钩子：config_callback
#
# 应用设置页提交后执行：按向导新值热更新 config.yaml（只改提交的字段，保留其余）。
#   - 密码走 yaml_dquote_escape + sed RHS 双重转义（与 install_callback 一致）
#   - v0.2.15：移除下载目录字段——download.dir 恒为容器内相对路径 data/downloads
#     （下载目录已固定挂载 data-share rainbow-music，见 compose），配置页不再可改
#   - v0.2.1 引入、#129/Track A 降级：扫描目录字段非空时仅留档（不再重渲染 compose
#     挂载与 RO_SCAN_ROOTS；回调期渲染对 Docker 形态 fpk 恒不生效，见 #88），也不再
#     因它重启容器；留空=保留旧留档不变。本地音乐导入改走共享目录 rainbow-library
#   - 有变更则重启容器生效；末尾幂等补齐数据目录

set -eu

# shellcheck source=/dev/null
source "$(cd "$(dirname "$0")" && pwd)/_common"

[ -f "$CONFIG_FILE" ] || render_config "${wizard_password:-}" "${wizard_port:-}" ""
changed=0
# v0.2.6：向导已移除端口项（服务监听由 compose 字面量 RO_SERVER_PORT=23330 固定，
# env 优先于 config.yaml）；本分支为兼容保留——若 fnOS 带旧字段重跑回调，仍只改
# config.yaml 值且空值安全跳过，不影响实际监听端口
if [ -n "${wizard_port:-}" ]; then
    case "$wizard_port" in
        *[!0-9]*|'') log_error "端口必须是数字：$wizard_port" ;;
    esac
    old_port=$(read_port)
    if [ "$old_port" != "$wizard_port" ]; then
        sed -i.bak "s|^\(  port:\).*|\1 ${wizard_port}|" "$CONFIG_FILE" && rm -f "$CONFIG_FILE.bak"
        changed=1
    fi
fi
if [ -n "${wizard_password:-}" ]; then
    # 与 render_config 一致：双引号标量 + YAML/sed 双重转义
    pass_esc=$(sed_escape_rhs "$(yaml_dquote_escape "${wizard_password}")")
    sed -i.bak "s|^\(    password:\).*|\1 \"${pass_esc}\"|" "$CONFIG_FILE" && rm -f "$CONFIG_FILE.bak"
    changed=1
fi
# v0.2.15：移除下载目录改写分支——download.dir 恒为相对 data/downloads，下载目录
# 固定挂载 data-share rainbow-music（见 compose），不再接受向导绝对路径覆盖
if [ -n "${wizard_scan_dirs:-}" ]; then
    # #129/Track A：仅留档（render_scan_mounts 已降级，不再渲染挂载与 RO_SCAN_ROOTS，
    # 也不再回读旧值）。刻意不置 changed=1：留档不产生任何运行时变化，为它重启容器
    # 只会白白打断在途下载与 SSE 长连接；密码/端口等真实变更仍由各自分支置位并重启
    render_scan_mounts "$wizard_scan_dirs"
fi
if [ "$changed" = "1" ] && compose_file_ok; then
    # 配置变更需要重启容器生效
    compose_up
fi
ensure_data_dirs
exit 0
