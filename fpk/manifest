appname=com.rainbow.music
version=0.2.19
display_name=Rainbow 音乐下载
desc=Rainbow 音乐下载服务：多音源聚合搜索、FLAC/MP3 无损下载、自动刮削元数据（封面/歌词/标签）、每日健康冒烟自检。Docker 容器运行，数据全部落在飞牛托管目录。
# App Center「已安装」卡片的分类副标题数据源是 appcenter 库 app.tags 列（fnOS 规范
# 分类键、逗号分隔多值，如 trim.music 的 "Audio,Video Entertainment"→「影音娱乐」）。
# 真机取证（#155）：tags 仅由商店源元数据(source_id)写入，手动安装(manual_install)应用
# 恒为 NULL；且 trim_app_center 的 manifest INI 解析键全集不含 tags/category——即当前
# fnOS 的 fpk manifest 没有可声明分类的字段，手装应用分类为空属平台行为、非包缺陷。
# 故此处仅以注释留档预期取值（Rainbow 属音乐类，应对齐 Audio,Video Entertainment），
# 不注入活跃未知键（不破坏安装优先于前向声明）；待 fnOS 支持 manifest 声明分类或
# Rainbow 走商店上架时，按此值启用 tags 字段。详见 docs/FNOS-DEPLOY.md 对应章节。
source=thirdparty
micro_app=true
platform=x86
arch=x86_64
os_min_version=1.0.0
maintainer=Rainbow
distributor=Rainbow
desktop_uidir=ui
desktop_applaunchname=com.rainbow.music.Application
service_port=0
checkport=false
ctl_stop=true
changelog=本次为功能强化更新，聚焦下载与搜索两条主线。下载侧：任务状态改为「未下载 / 下载中 / 已下载」三态统一呈现，下载完成后回写文件真实码率与编码格式（不再只信平台标称音质）；同名文件默认追加序号不覆盖既有曲库，下载字节数与响应长度不一致会记为完整性告警；新增断点续传（失败或重启后按 Range 续下，不从头重来）、按「歌手/专辑」自动归类落盘子目录、批量入队去重与批次视图（整单下载歌单、仅下未拥有项、整批取消）、队列暂停/恢复与批量重试/取消/清空失败；失败原因结构化为稳定错误码并记录每次换源与重试的审计轨迹，前端可展开查看「为什么失败」；入队前预检磁盘可用空间，不足时直接拒绝并明确提示。搜索侧：新增搜索历史（去重置顶、可清空）、输入联想与热搜榜、跨平台合并去重视图（按歌曲聚合、可展开全部来源）、本地相关度评分排序、拼音全拼与首字母匹配（如 zjl 命中周杰伦）、结果过少时的错字纠错建议与相关推荐、结果筛选与多种排序。音源侧：按近期冒烟成功率对候选音源排序、对持续失败的音源临时熔断剔除、支持每音源限速，减少在坏源上白等；封面与音频改为并行下载，进度推送节流，降低大批量下载时的开销。另新增结果内试听（不落盘、不占下载配额）与「我喜欢」收藏，播放器与搜索页收藏状态同步。
